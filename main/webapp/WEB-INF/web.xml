<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="false">
    
    <display-name>Service Booking Application</display-name>
    
    <welcome-file-list>
        <welcome-file>public/index.jsp</welcome-file>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
    
    <!-- Service Categories Servlet -->
    <servlet>
        <servlet-name>ServiceCategoriesServlet</servlet-name>
        <servlet-class>servlet.pub.ServiceCategoriesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServiceCategoriesServlet</servlet-name>
        <url-pattern>/mvc/public/serviceCategories</url-pattern>
    </servlet-mapping>
    
    <!-- Service Details Servlet -->
    <servlet>
        <servlet-name>ServiceDetailsServlet</servlet-name>
        <servlet-class>servlet.pub.ServiceDetailsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServiceDetailsServlet</servlet-name>
        <url-pattern>/mvc/public/serviceDetails</url-pattern>
    </servlet-mapping>
    
    <!-- Search Caregivers Servlet -->
    <servlet>
        <servlet-name>SearchCaregiversServlet</servlet-name>
        <servlet-class>servlet.pub.SearchCaregiversServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SearchCaregiversServlet</servlet-name>
        <url-pattern>/mvc/api/searchCaregivers</url-pattern>
    </servlet-mapping>
    
    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.jsp</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.jsp</location>
    </error-page>
</web-app>
